        {
          "english": "student",
          "turkish": "öğrenci"
        },
        {
          "english": "researcher",
          "turkish": "araştırmacı"
        },
        {
          "english": "geography",
          "turkish": "coğrafya"
        }
      ],
      "examples": [
        {
          "english": "I am a student.",
          "turkish": "Ben öğrenciyim."
        },
        {
          "english": "You are a researcher.",
          "turkish": "Sen araştırmacısın."
        }
      ],
      "quiz": [
        {
